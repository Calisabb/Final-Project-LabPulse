{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost\\SQLEXPRESS;Database=LabPulseDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "LabPulse",
    "Audience": "LabPulseClient",
    "ExpiresMinutes": 60
  },
  "HealthCheck": {
    "IntervalSeconds": 30
  }
}

